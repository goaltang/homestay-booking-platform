# ============================================
# homestay3 生产部署环境变量模板
# 用法：cp .env.example .env，填入真实值（.env 已被 gitignore）
# ============================================

# JWT 密钥（必填，至少 32 字符）：openssl rand -base64 48
JWT_SECRET=change-me-64-char-random-secret

# MySQL（compose 服务名 mysql，root 密码与业务账号分离）
DB_URL="jdbc:mysql://mysql:3306/homestay_db?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8&useUnicode=true&allowPublicKeyRetrieval=true"
DB_USERNAME=homestay
DB_PASSWORD=change-me-db
DB_ROOT_PASSWORD=change-me-root

# Redis（可为空）
REDIS_PASSWORD=

# RabbitMQ 凭据（与 compose 中一致）
RABBITMQ_USER=homestay
RABBITMQ_PASSWORD=homestay123

# 支付宝（生产用正式应用密钥；本地沙箱可留空）
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=

# 生产首次启动的管理员初始密码（admin 不存在时创建）
ADMIN_INIT_PASSWORD=change-me-admin

# 对外访问地址（图片/回调拼装用，如 https://api.example.com）
APP_SERVER_URL=http://localhost:8081
