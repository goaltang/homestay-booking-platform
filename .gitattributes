# 文本文件统一用 LF 存储于仓库，checkout 时按平台转换
* text=auto

# 特定文件类型强制 LF（跨平台一致，防止 Windows 工具写 CRLF）
*.java text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.vue text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.properties text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf

# 二进制文件不做行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.jar binary
*.zip binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.lock binary
