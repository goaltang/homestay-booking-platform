# ============================================
# homestay3 公网展示部署环境变量（国内服务器，按 IP 访问，无域名、无 HTTPS）
# 用法：cp .env.prod.example .env，逐项替换；.env 已被 gitignore
# 生成密钥：openssl rand -base64 48
# 下文 1.2.3.4 统一替换为你的服务器公网 IP
# ============================================

# ---------- 访问入口 ----------
# 用户端与管理端对外端口（需在云厂商安全组放行）
SITE_PORT=80
ADMIN_PORT=8089
# 后端拼装图片/回调地址用；用户端不是 80 端口时要带上端口
APP_SERVER_URL=http://1.2.3.4

# 跨域白名单（同源部署时用户不会触发跨域，仅直连 API 时生效）
APP_CORS_ALLOWED_ORIGINS=http://1.2.3.4,http://1.2.3.4:8089

# ---------- 密钥 ----------
# 必填，至少 32 字符：openssl rand -base64 48
JWT_SECRET=replace-with-64-char-random-secret

# ---------- MySQL ----------
DB_URL="jdbc:mysql://mysql:3306/homestay_db?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8&useUnicode=true&allowPublicKeyRetrieval=true"
DB_USERNAME=homestay
DB_PASSWORD=replace-with-strong-db-password
DB_ROOT_PASSWORD=replace-with-strong-root-password

# ---------- Redis（生产必填，不允许空密码） ----------
REDIS_PASSWORD=replace-with-strong-redis-password

# ---------- RabbitMQ ----------
RABBITMQ_USER=homestay
RABBITMQ_PASSWORD=replace-with-strong-mq-password

# ---------- 搜索（4G 机器保持 false，走 JPA；需要 ES 时见 docs/INSTALL.md） ----------
ELASTICSEARCH_ENABLED=false

# ---------- 地图（地图找房的地点联想；与前端 VITE_AMAP_WEB_SERVICE_KEY 同一个高德 Web 服务 Key） ----------
AMAP_API_KEY=

# ---------- 公开演示（可选，不对外演示就留空） ----------
# 填演示快照里的账号后，登录页和首页出现“一键体验”，后端禁止这两个账号改密码和资料
# 修改后要重新构建前端：docker compose -f docker-compose.prod.yml up -d --build front backend
DEMO_GUEST_USERNAME=
DEMO_HOST_USERNAME=

# ---------- 支付宝（沙箱可留空；正式需要营业执照） ----------
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=http://1.2.3.4/api/payment/alipay/notify
ALIPAY_RETURN_URL=http://1.2.3.4/orders/pay/success
